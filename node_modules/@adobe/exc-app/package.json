{
  "name": "@adobe/exc-app",
  "version": "1.6.3",
  "main": "index.js",
  "source": "index.ts",
  "scripts": {
    "docs": "rm -rf docs && npm run typedoc",
    "format": "eslint . --fix --ext=.ts",
    "lint": "eslint . --ext=.ts",
    "preBuild": "node build/preBuild.js",
    "prepack": "yarn preBuild && tsc",
    "readmeupdate": "cp README.md docs && sed -i -e 's/\\/docs//g' docs/README.md && rm -rf docs/README.md-e",
    "test": "cross-env NODE_ENV=test jest tests/* --coverage && tsc --noEmit",
    "test:changes": "cross-env NODE_ENV=test jest --onlyChanged tests/*",
    "typedoc": "typedoc --hideSources --options typedocOptions.json",
    "types": "tsc --noEmit"
  },
  "license": "CC-BY-ND-4.0",
  "files": [
    "docs/**/*.md",
    "*.d.ts",
    "**/*.d.ts",
    "*.js",
    "**/*.js",
    "*.js.map",
    "**/*.js.map"
  ],
  "description": "This project provides the interface for app developers to integrate with the experience cloud unified shell web application at https://experience.adobe.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com/"
  },
  "peerDependencies": {
    "@apollo/client": "^3.8.9",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@apollo/client": "3.8.9",
    "@eslint/js": "9.35.0",
    "@stylistic/eslint-plugin": "5.3.1",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "cross-env": "7.0.3",
    "eslint": "9.35.0",
    "eslint-plugin-headers": "1.3.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.0.1",
    "eslint-plugin-jsdoc": "55.1.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-rulesdir": "0.2.2",
    "glob": "8.0.3",
    "globals": "16.4.0",
    "graphql-tag": "2.12.6",
    "jest": "30.0.5",
    "jsdoc-to-markdown": "9.1.1",
    "typedoc": "0.27.2",
    "typedoc-plugin-external-module-name": "4.0.6",
    "typedoc-plugin-markdown": "4.4.1",
    "typescript": "5.5.3",
    "typescript-eslint": "8.43.0"
  }
}